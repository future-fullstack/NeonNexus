---
import {withBase} from '../lib/paths';
import type {Post} from '../lib/contracts';
import type {Heading} from '../lib/markdown';
import SiteLayout from '../components/SiteLayout.astro';
import {formatDate} from '../lib/posts';
import {SITE_TITLE} from '../consts';
import ReadingRoom from '../components/ReadingRoom.astro';
import '../styles/reading-room.css';
type Props=Post & {headings?:Heading[]};
const {slug,title,description,pubDate,updatedDate,heroImage,tags=[],headings=[]}=Astro.props;
const contents=headings.filter(heading=>heading.depth===2 || heading.depth===3);
---
<SiteLayout title={`${title} · ${SITE_TITLE}`} description={description}>
  <article class="article-page shell"><a class="back-link" href={withBase('/blog/')}>← 回到文章架</a><div class="panel article-panel"><header class="article-heading"><p class="eyebrow">JOURNAL ENTRY / 文章</p><h1>{title}</h1><div class="post-meta"><time datetime={pubDate}>{formatDate(pubDate)}</time>{tags.map(tag=><span class="post-tag">#{tag}</span>)}</div><p class="article-description">{description}</p>{updatedDate && <p class="updated-date">更新于 <time datetime={updatedDate}>{formatDate(updatedDate)}</time></p>}</header>{heroImage && <img class="article-image" src={withBase(heroImage)} alt="" width="1200" height="600"/>}<ReadingRoom slug={slug}/>{contents.length>0 && <aside class="article-toc-rail" aria-label="文章目录"><details class="article-toc" data-reading-toc open><summary>这一页的目录</summary><ol>{contents.map(heading=><li class:list={[{'toc-nested':heading.depth===3}]}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details></aside>}<div class="prose article-body" tabindex="-1"><slot/></div><div class="article-end"><span aria-hidden="true">✧ · ✧ · ✧</span><p>这一页，先写到这里。</p><a class="article-message-link" href={withBase('/messages/')}>有什么想说的，留几句话给我 ✉</a><a href={withBase('/blog/')}>继续翻文章架 →</a></div></div></article>
</SiteLayout>
