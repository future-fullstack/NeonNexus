---
import {Mail, LampDesk, X} from '@lucide/astro';
const leaves=[[70,206],[105,170],[148,134],[185,97],[202,150],[121,248],[79,292],[496,151],[539,210],[577,260],[541,308]];
const stars=[[77,59],[211,39],[298,72],[357,45],[514,83],[461,137],[155,104]];
---
<div class="beijing-window" data-lamp="on">
  <div class="scene-caption"><span class="live-dot" aria-hidden="true"></span><span>观察窗 · 北京</span><span class="scene-coordinate">39.90° N / 116.41° E</span></div>
  <div class="landscape-frame">
    <svg class="beijing-view" viewBox="0 0 640 510" role="img" aria-labelledby="beijing-window-title">
      <title id="beijing-window-title">窗外的北京：远处的城市与胡同，四季的树，近处有猫、茶和一盏灯。</title>
      <defs>
        <linearGradient id="sky-wash" x2="0" y2="1"><stop stop-color="var(--sky-color)"/><stop offset="1" stop-color="var(--horizon-color)"/></linearGradient>
        <linearGradient id="mist-wash" x2="0" y2="1"><stop stop-color="var(--cloud-color)" stop-opacity="0"/><stop offset=".55" stop-color="var(--cloud-color)" stop-opacity=".46"/><stop offset="1" stop-color="var(--cloud-color)" stop-opacity="0"/></linearGradient>
        <radialGradient id="sun-halo"><stop stop-color="#f5d69a" stop-opacity=".6"/><stop offset="1" stop-color="#f5d69a" stop-opacity="0"/></radialGradient>
      </defs>
      <rect width="640" height="510" fill="url(#sky-wash)"/>
      <g class="scene-sun"><circle cx="454" cy="109" r="90" fill="url(#sun-halo)"/><circle cx="454" cy="109" r="30" fill="#e9c885"/></g>
      <g class="scene-moon"><circle cx="454" cy="109" r="28" fill="#e3dbb9"/><circle cx="465" cy="100" r="25" class="scene-sky"/></g>
      <g class="scene-stars" fill="#e1dcbb">{stars.map(([cx,cy])=><circle cx={cx} cy={cy} r="1.4"/>)}</g>
      <g class="weather-clouds" fill="var(--cloud-color)" opacity=".45"><path d="M70 133c36-39 105-48 162-21-12 18-141 35-162 21Z"/><path d="M332 60c52-29 127-33 175-11-57 16-123 15-175 11Z"/></g>
      <g class="heavy-clouds" fill="var(--cloud-color)" opacity=".5"><path d="M-25 32Q133 4 252 47T668 25V117Q475 127 283 91T-25 100Z"/></g>
      <path d="M0 278q97-31 161-11t151 4 144-33 184 39v233H0Z" fill="var(--ground-color)" opacity=".65"/>
      <g class="scene-city" fill="var(--city-color)" opacity=".55"><path d="M133 295v-77h21v-12h24v89m19 0V183h36v112m17 0v-64h26v64m39 0V157h7v-14h8v14h9v138m37 0v-92h25v92m17 0v-84h27l11 40h12l-14-93h18l19 137m32 0V211h37v84m20 0v-62h29v62"/><path d="M197 198h36m81-14h25m-25 16h25m-25 16h25" stroke="var(--city-detail)" stroke-width="2"/></g>
      <g class="hutong-near">
        <path d="M-20 367v-42h175v42m17 4v-72h184v72m14 27v-78h171v78m16 20v-61h92v61" fill="var(--house-color)"/>
        <g fill="var(--roof-color)"><path d="M-31 327q54-13 90-31 49 31 106 31l-6 8H-28Z"/><path d="M159 302q54-10 97-34 46 28 111 34l-5 9H165Z"/><path d="M359 323q40-8 77-25 51 29 117 25l-10 10H365Z"/><path d="M544 359q36-7 61-22 24 16 58 22v8H544Z"/></g>
        <g fill="var(--house-window)"><rect x="24" y="343" width="28" height="28" rx="1"/><rect x="100" y="343" width="28" height="28" rx="1"/><rect x="189" y="329" width="28" height="27" rx="1"/><rect x="302" y="329" width="28" height="27" rx="1"/><rect x="391" y="351" width="29" height="28" rx="1"/><rect x="486" y="351" width="29" height="28" rx="1"/></g>
        <g stroke="var(--roof-color)" stroke-width="2" fill="none"><path d="M38 343v28m-14-14h28m62-14v28m-14-14h28m75-14v27m-14-13h28m99-14v27m-14-13h28m75-5v28m-15-14h29m81-14v28m-15-14h29"/></g>
        <path d="M237 320h49v55h-49Z" fill="#765248"/><path d="M261 324v48" stroke="#b18a6c"/>
        <path d="M-25 417q198-71 355-24t334 24v93H-25Z" fill="var(--ground-color)"/>
        <g class="roof-snow" stroke="#e9eee8" stroke-width="4" fill="none"><path d="M-20 325q37-9 79-28 47 29 97 29m15-24q45-11 85-33 42 26 96 30m20 24q37-10 64-24 44 23 103 25"/></g>
      </g>
      <g class="scene-tree" fill="none" stroke="var(--trunk-color)" stroke-linecap="round"><path d="M-2 482Q52 378 53 262T86 22M49 283q43-59 62-111t97-91M56 205Q9 158 9 101M34 371q79-34 111-105M633 436Q586 335 584 239T539 61M589 297q-52-69-77-110M583 224q47-43 48-104" stroke-width="5"/><path d="M98 197q50 2 93-47M520 204q-35-10-40-55M83 314q9-16-5-24" stroke-width="2"/></g>
      <g class="season-foliage">{leaves.map(([cx,cy],i)=><ellipse cx={cx} cy={cy} rx={25+i%3*10} ry={13+i%3*7} transform={`rotate(${i%2?30:-30} ${cx} ${cy})`} fill="var(--leaf-color)" opacity={.45+i%3*.12}/>)}</g>
      <g class="spring-blossoms" fill="#e7b7af">{leaves.map(([cx,cy])=><circle cx={cx+13} cy={cy+8} r="4"/>)}</g>
      <g class="weather-fog"><rect y="210" width="640" height="245" fill="url(#mist-wash)"/></g>
      <g class="weather-lightning" fill="#f8edd1"><path d="M380 80l-21 40h15l-30 48 9-37h-17l27-51Z"/></g>
      <path d="M0 460H640v50H0Z" fill="var(--sill-color)"/><path d="M0 461H640" stroke="var(--sill-edge)"/>
      <g class="sill-books"><rect x="92" y="445" width="65" height="10" rx="2" fill="#8c9c86"/><rect x="97" y="434" width="62" height="10" rx="2" fill="#b9947f"/><path d="M105 438h48m-53 11h50" stroke="#efe6d7" stroke-width="2"/></g>
      <g class="sill-cat" fill="#af9574"><path d="M227 461c-16 0-23-11-24-19l-3-26 15 9 15-9 5 18c21-6 41 4 41 20 15 2 23-5 18-14-6-10 8-14 10-3 4 19-12 26-30 25Z"/><path d="M210 438h3m10 0h3" stroke="#52483f" stroke-width="2" stroke-linecap="round"/></g>
      <g class="sill-cup"><path d="M342 428h30v27q-15 11-30 0Zm30 4c18-4 18 21 0 17" fill="#d7ccb1" stroke="#9a957f"/><path d="M346 432h22" stroke="#8a7159" stroke-width="3"/><g class="tea-steam" stroke="var(--steam-color)" stroke-width="2" fill="none"><path d="M351 420q-6-8 0-16t0-14m11 32q7-8 1-14"/></g></g>
      <g class="sill-lamp"><path d="M545 453h36m-18 0v-54m-24-1h48l-11-25h-26Z" fill="var(--lamp-shade)" stroke="var(--lamp-shade)" stroke-width="4" stroke-linecap="round"/><path d="M542 400h43" class="lamp-bulb" stroke-width="3"/></g>
    </svg>
    <canvas class="atmosphere-canvas" style="width:100%;height:90%" data-atmosphere aria-hidden="true"></canvas>
    <div class="observation-reticle" aria-hidden="true"><span class="reticle-cross">＋</span><span class="reticle-side">BEIJING · TODAY</span></div>
    <div class="window-weather-mask" aria-hidden="true">
      <div class="weather-rain">{Array.from({length:24},(_,i)=><i style={`--x:${i*37%100}%;--y:${i*29%100}%;--delay:-${i%9}s;--speed:${.8+i%4*.2}s`}/>)}</div>
      <div class="weather-snow">{Array.from({length:18},(_,i)=><i style={`--x:${i*41%100}%;--y:${i*31%100}%;--delay:-${i%8}s;--speed:${7+i%5}s`}/>)}</div>
      <div class="season-leaves">{Array.from({length:7},(_,i)=><i style={`--x:${i*43%100}%;--y:${i*19%100}%;--delay:-${i%6}s;--speed:${8+i%4}s`}/>)}</div>
    </div>
    <div class="lamp-glow" aria-hidden="true"></div>
    <div class="scene-actions"><button type="button" data-lamp-toggle aria-label="关掉窗台的灯" aria-pressed="true"><LampDesk size={17} stroke-width={1.4} aria-hidden="true"/><span>一盏灯</span></button><button type="button" data-note-toggle aria-label="打开窗台上的信封" aria-expanded="false" aria-controls="window-envelope-note"><Mail size={17} stroke-width={1.4} aria-hidden="true"/><span>一封信</span></button></div>
    <div class="envelope-note" id="window-envelope-note" hidden><button type="button" data-note-close aria-label="合上这封信"><X size={16} aria-hidden="true"/></button><span class="note-date">留给多看一眼的人</span><p>这里没准会有好玩的东西哦（笑</p><span class="note-sign" aria-hidden="true">✧</span></div>
  </div>
  <div class="scene-footnote"><span>一只猫，一杯茶，窗外是今天。</span><span data-season-label>北京 · 秋日窗边</span></div>
</div>
<script>import '../scripts/atmosphere';</script>
