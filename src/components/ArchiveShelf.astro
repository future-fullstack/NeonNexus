---
import {withBase} from '../lib/paths';
import PostCard from './PostCard.astro';
import type {PostSummary} from '../lib/contracts';
interface Props {posts:PostSummary[];contentError?:string;}
const {posts,contentError=''}=Astro.props;
const topics=[...new Set(posts.flatMap(post=>post.tags||[]))].sort((a,b)=>a.localeCompare(b,'zh-CN'));
---
	<div class="archive-page shell">
		<section class="archive-room" aria-labelledby="archive-title">
			<div class="archive-bar"><span class="mono">THE READING ROOM</span><span class="mono">{contentError?'文章暂未连上':`${String(posts.length).padStart(2,'0')} ENTRIES`}</span></div>
			<header class="archive-intro"><h1 id="archive-title">文章架</h1><p>挑一篇，坐一会儿。日子和想法都留在这里。</p></header>
			{!contentError&&topics.length>0&&<div class="archive-topics" data-archive-topics hidden><p>从一个话题逛起</p><div role="group" aria-label="按话题筛选文章"><button type="button" data-topic-all aria-pressed="true">全部文章</button>{topics.map(topic=><button type="button" data-topic={topic} aria-pressed="false">{topic}</button>)}</div><p class="topic-status" data-topic-status role="status" aria-live="polite">共 {posts.length} 篇文章</p></div>}
			{contentError?<p class="empty-state">{contentError}</p>:posts.length ? <div class="post-list">{posts.map((post, index) => <div data-topic-post data-topics={JSON.stringify(post.tags||[])}><PostCard post={post} index={index} /></div>)}</div> : <p class="empty-state">第一篇文章还在路上。这一格，先留空。</p>}
			<p class="empty-state" data-topic-empty hidden>这个话题暂时没有文章。<button type="button" data-topic-clear>看看全部文章</button></p>
			<div class="archive-end"><a href={withBase('/')}>← 回到小站</a><a href={withBase('/rss.xml')}>RSS 订阅 ↗</a></div>
		</section>
	</div>
<script>import '../scripts/archive-topics';</script>
<style>
	.archive-page {padding: 0 0 1.5rem;}
	.archive-room {border: 1px solid var(--line); background: var(--surface);}
	.archive-bar {display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; padding: .65rem 1.25rem; border-bottom: 1px solid var(--line); color: var(--muted);}
	.archive-intro {padding: 1.25rem 1.25rem .75rem;}
	h1 {font-size: 1.7rem; line-height: 1.4; margin: 0 0 .45rem;}
	.archive-intro p {margin: 0; color: var(--muted); font-size: .9rem;}
	.post-list {padding: 0 1.25rem;}
	.archive-end {display: flex; justify-content: space-between; gap: .75rem; flex-wrap: wrap; padding: 1rem 1.25rem; color: var(--muted); font-size: .85rem;}
	.empty-state {padding: 1.25rem;}
	@media (max-width: 400px) {.archive-bar,.archive-intro,.archive-end {padding-inline: .85rem;} .post-list {padding-inline: .85rem;}}
</style>
