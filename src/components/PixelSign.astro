---
interface Props { text: string; }
const {text} = Astro.props;
// A tiny, original 5 × 7 block alphabet for the sign. Chinese titles use normal text.
const glyphs:Record<string,string[]> = {
A:['01110','10001','10001','11111','10001','10001','10001'],B:['11110','10001','10001','11110','10001','10001','11110'],C:['01111','10000','10000','10000','10000','10000','01111'],D:['11110','10001','10001','10001','10001','10001','11110'],E:['11111','10000','10000','11110','10000','10000','11111'],F:['11111','10000','10000','11110','10000','10000','10000'],G:['01111','10000','10000','10111','10001','10001','01111'],H:['10001','10001','10001','11111','10001','10001','10001'],I:['11111','00100','00100','00100','00100','00100','11111'],J:['00111','00010','00010','00010','10010','10010','01100'],K:['10001','10010','10100','11000','10100','10010','10001'],L:['10000','10000','10000','10000','10000','10000','11111'],M:['10001','11011','10101','10101','10001','10001','10001'],N:['10001','11001','11001','10101','10011','10011','10001'],O:['01110','10001','10001','10001','10001','10001','01110'],P:['11110','10001','10001','11110','10000','10000','10000'],Q:['01110','10001','10001','10001','10101','10010','01101'],R:['11110','10001','10001','11110','10100','10010','10001'],S:['01111','10000','10000','01110','00001','00001','11110'],T:['11111','00100','00100','00100','00100','00100','00100'],U:['10001','10001','10001','10001','10001','10001','01110'],V:['10001','10001','10001','10001','10001','01010','00100'],W:['10001','10001','10001','10101','10101','11011','10001'],X:['10001','10001','01010','00100','01010','10001','10001'],Y:['10001','10001','01010','00100','00100','00100','00100'],Z:['11111','00001','00010','00100','01000','10000','11111'],' ':['00000','00000','00000','00000','00000','00000','00000']};
const letters = Array.from(text.toUpperCase());
const supported = letters.length > 0 && letters.every(letter => glyphs[letter]);
const width = letters.length * 6 + 2;
const path = supported ? letters.flatMap((letter,index) => glyphs[letter].flatMap((row,y) => [...row].flatMap((bit,x) => bit === '1' ? [`M${index*6+x+1},${y+1}h1v1h-1z`] : []))).join('') : '';
---
{supported ? <svg class="pixel-sign" viewBox={`0 0 ${width} 9`} aria-hidden="true" shape-rendering="crispEdges"><path d={path} fill="#0b353b" stroke="#427a80" stroke-width=".35" transform="translate(.45 .45)"/><path d={path} fill="#72c6c0" stroke="#1e6873" stroke-width=".12"/></svg> : <span class="text-sign">{text}</span>}