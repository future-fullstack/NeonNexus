---
import type {PostSummary} from '../lib/contracts';
import {postHref,formatDate} from '../lib/posts';
interface Props { post:PostSummary; index?:number; }
const {post,index=0}=Astro.props;
---
<article class="post-row"><span class="post-index mono" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div class="post-summary"><h3><a href={postHref(post)}><span class="post-title">{post.title}</span><span class="post-arrow" aria-hidden="true">↗</span></a></h3><div class="post-meta"><time datetime={post.pubDate}>{formatDate(post.pubDate)}</time>{post.tags?.slice(0,2).map(tag=><span class="post-tag">#{tag}</span>)}</div><p>{post.description}</p></div></article>
