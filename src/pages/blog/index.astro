---
import SiteLayout from '../../components/SiteLayout.astro';
import ArchiveShelf from '../../components/ArchiveShelf.astro';
import { getPublicPosts } from '../../lib/posts';
import { SITE_TITLE } from '../../consts';
import type {PostSummary} from '../../lib/contracts';
let posts:PostSummary[]=[],contentError='';
try{posts=await getPublicPosts();}catch{contentError='文章架暂时没连上，稍后再来翻翻吧。';Astro.response.status=503;}
Astro.response.headers.set('Cache-Control','no-store');
---

<SiteLayout title={`文章 · ${SITE_TITLE}`} description="这个小站慢慢积累的文字。">
  <ArchiveShelf posts={posts} contentError={contentError}/>
</SiteLayout>
